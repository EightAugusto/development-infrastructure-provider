# Default
DOCKER_NETWORK=eightaugusto

DEFAULT_USER=eightaugusto
DEFAULT_PASSWORD=changeme
DEFAULT_SECRET=secret

# Jaeger
JAEGER_PUBLIC_PORT=16686
JAEGER_COLLECTOR_ZIPKIN_HOST_PORT=9411

# Kafka
KAFKA_CLUSTER_ID=eightaugusto-kafka-cluster
KAFKA_CONTROLLER_PORT=9093
KAFKA_BROKER_PORT=9092
KAFKA_1_PUBLIC_PORT=29092
KAFKA_2_PUBLIC_PORT=29093
KAFKA_3_PUBLIC_PORT=29094
KAFKA_UI_PUBLIC_PORT=29090

# Keycloak
KEYCLOAK_PUBLIC_PORT=8080
KEYCLOAK_PORT=8080

# Nexus
NEXUS_PUBLIC_PORT=8081
NEXUS_DOCKER_PORT=8082

# Ollama
OLLAMA_MODEL=tinyllama:1.1b
OLLAMA_WEBUI_PUBLIC_PORT=80

# Prometheus
PROMETHEUS_PUBLIC_PORT=9090